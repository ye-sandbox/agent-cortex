# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — agent-cortex
# ==============================================================================
# Copy this file to `.env` and fill in your actual environment values:
# cp .env.example .env
#
# RULE: NEVER commit `.env` containing sensitive credentials to the repository.
# ==============================================================================

# [Runtime Configuration Path Override]
# Optional path to cortex.yaml (defaults to ./cortex.yaml or ~/.config/agent-cortex/config.yaml)
# AGENT_CORTEX_CONFIG=./cortex.yaml

# [Storage & Persistence]
# Directory for local LanceDB storage and indexes (never inside git repo)
AGENT_CORTEX_DATA_DIR=~/.local/share/agent-cortex/data

# [Hardware Profile]
# Active hardware profile: cpu_lean, cpu_fast, gpu_standard, custom
CORTEX_PROFILE=cpu_lean

# [Multi-Tenant Scoping]
# Default tenant ID for vector retrieval and dynamic configuration
CORTEX_TENANT_ID=default

# [Dual-Mode Remote Hub (Client Mode)]
# Set these when connecting to a remote agent-cortex hub instance
CORTEX_HUB_URL=
CORTEX_API_KEY=

# [Daemon / Server Mode]
# Binding host and port when running `agent-cortex serve`
APP_HOST=127.0.0.1
APP_PORT=8000
API_KEY=
